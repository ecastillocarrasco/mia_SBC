# Copia este fichero a .env y rellena los valores. .env NUNCA se sube al repositorio.
# En Azure estas variables llegan desde Key Vault (ver infra/).

MIA_ENVIRONMENT=local              # local | test | dev | production
MIA_PORT=5001
MIA_COMPAT_PORT=5002               # solo local: el frontend actual espera el gateway en 5002
MIA_TIMEZONE=Europe/Madrid
MIA_DATABASE_URL=postgresql+asyncpg://mia:mia@localhost:5432/mia

# LLM: openai | azure_openai | fake (fake = sin clave, respuestas de prueba)
MIA_LLM__PROVIDER=fake
MIA_LLM__API_KEY=
MIA_LLM__MODEL=gpt-4.1-mini
MIA_LLM__BASE_URL=https://api.openai.com/v1
# Azure OpenAI: MIA_LLM__PROVIDER=azure_openai, MIA_LLM__BASE_URL=https://<recurso>.openai.azure.com/openai/v1
#               MIA_LLM__MODEL=<nombre del despliegue>

# Voz: elevenlabs | none
MIA_VOICE__PROVIDER=none
MIA_VOICE__API_KEY=
MIA_VOICE__VOICE_ID=
MIA_VOICE__MODEL_ID=eleven_flash_v2_5

# Identidad: dev (fija, solo local) | easyauth | entra (MSAL + token de API, requerido para OBO de Graph)
MIA_AUTH__MODE=dev
MIA_AUTH__DEV_DISPLAY_NAME=Enrique
MIA_AUTH__DEV_ROLES=["mia.admin"]
# Con MIA_AUTH__MODE=entra, CV-SunsetBeachClub es la API y cliente confidencial OBO; cada cliente
# público usa su propio registro de Entra y pide el scope de esta API.
# MIA_AUTH__ENTRA_TENANT_ID=
# MIA_AUTH__ENTRA_CLIENT_ID=                 # Client ID de CV-SunsetBeachClub (API/OBO)
# MIA_AUTH__ENTRA_WEB_CLIENT_ID=             # Client ID de mia_Login
# MIA_AUTH__ENTRA_DESKTOP_CLIENT_ID=         # Client ID de mia_Login_Desktop
# MIA_AUTH__ENTRA_ROLE_CLAIM=roles
MIA_AUTH__ENTRA_SCOPE=api://<client-id>/access_as_user
# Correo OBO usa certificado para intercambiar el token de la API por Graph; el certificado
# debe estar registrado en CV-SunsetBeachClub, cuyo ID se indica en MIA_AUTH__ENTRA_CLIENT_ID.

# SharePoint (sitio de RRHH). Mismos valores que el .env anterior:
#   MIA_TENANT_ID → TENANT_ID · MIA_CLIENT_ID → CLIENT_ID · MIA_CERT_THUMBPRINT → CERT_THUMBPRINT
#   MIA_SHAREPOINT_HOST → HOST · MIA_RRHH_URL → RRHH_SITE_URL · MIA_CERT_PFX_* → CERT_PFX_*
MIA_SHAREPOINT__TENANT_ID=
MIA_SHAREPOINT__CLIENT_ID=
MIA_SHAREPOINT__CERT_THUMBPRINT=
MIA_SHAREPOINT__HOST=sunsetbeachclub.sharepoint.com
MIA_SHAREPOINT__RRHH_SITE_URL=
MIA_SHAREPOINT__PORTAL_SITE_URL=https://sunsetbeachclub.sharepoint.com/sites/PortalCorporativo
MIA_SHAREPOINT__CERT_PFX_PATH=
MIA_SHAREPOINT__CERT_PFX_PASSWORD=

# Clave para seudonimizar DNI/NIE. Genera una propia y NO la cambies después
# (cambiarla obliga a una sincronización completa). En producción, desde Key Vault.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MIA_DATA__PSEUDONYM_KEY=

# Dominios activos (por defecto todos). Para desactivar uno, quítalo de la lista.
# MIA_DOMAINS__ENABLED=["empleados","turnos","vacaciones","curriculums","correo","nominas","documentos","trabajo_temporal","informes"]

# Correo: buzón compartido de RRHH (misma app y certificado que SharePoint; antes MIA_OUTLOOK_MAILBOX)
MIA_MAIL__MAILBOX=
# Qué buzón usa cada usuario: «configured» (desarrollo: el de MIA_MAIL__MAILBOX, el mismo para todos) o «user»
# (con MSAL/Entra ID: el de la cuenta con la que inicia sesión; MIA_MAIL__MAILBOX deja de hacer falta).
MIA_MAIL__MAILBOX_SOURCE=configured
MIA_MAIL__DRAFTS_ENABLED=true
MIA_MAIL__SEND_ENABLED=false          # enviar exige además confirmación explícita en la conversación

# Currículums: modelo de embeddings para la búsqueda semántica (en Azure, nombre del despliegue)
MIA_CURRICULUMS__EMBEDDING_MODEL=text-embedding-3-small

# Informes generados (PDF/Excel)
MIA_REPORTS__DIRECTORY=informes
MIA_REPORTS__TTL_HOURS=24
MIA_REPORTS__LOGO_PATH=                # logo corporativo (antes MIA_SBC_LOGO_PATH)

# Contenido de nóminas y documentos (permiso propio, auditado, nunca se guarda ni se locuta)
MIA_DATA__CONTENT_ENABLED=true

# Búsqueda web para consultas generales (si el proveedor no la admite, se desactiva sola)
MIA_LLM__WEB_SEARCH=true

# Frontend actual servido desde su ubicación (opcional)
# MIA_FRONTEND__LEGACY_HTML=C:/ruta/al/proyecto/anterior/mia.html
# MIA_FRONTEND__ASSETS_DIR=C:/ruta/al/proyecto/anterior/assets

MIA_OBSERVABILITY__LOG_JSON=false
MIA_OBSERVABILITY__LOG_LEVEL=INFO
