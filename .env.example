# Copia este fichero a .env y rellena los valores. .env NUNCA se sube al repositorio.
# En Azure estas variables llegan desde Key Vault (ver infra/).

MIA_ENVIRONMENT=local              # local | test | dev | production
MIA_PORT=5001
MIA_COMPAT_PORT=5002               # solo local: el frontend actual espera el gateway en 5002
MIA_TIMEZONE=Europe/Madrid
MIA_DATABASE_URL=postgresql+asyncpg://mia:mia@localhost:5432/mia

# LLM: openai | azure_openai | fake (fake = sin clave, respuestas de prueba)
MIA_LLM__PROVIDER=fake
MIA_LLM__API_KEY=
MIA_LLM__MODEL=gpt-4.1-mini
MIA_LLM__BASE_URL=https://api.openai.com/v1
# Azure OpenAI: MIA_LLM__PROVIDER=azure_openai, MIA_LLM__BASE_URL=https://<recurso>.openai.azure.com/openai/v1
#               MIA_LLM__MODEL=<nombre del despliegue>

# Voz: elevenlabs | none
MIA_VOICE__PROVIDER=none
MIA_VOICE__API_KEY=
MIA_VOICE__VOICE_ID=
MIA_VOICE__MODEL_ID=eleven_flash_v2_5

# Identidad: dev (fija, solo local) | easyauth (Azure, autenticación integrada)
MIA_AUTH__MODE=dev
MIA_AUTH__DEV_DISPLAY_NAME=Enrique
MIA_AUTH__DEV_ROLES=["mia.admin"]

# Frontend actual servido desde su ubicación (opcional)
# MIA_FRONTEND__LEGACY_HTML=C:/ruta/al/proyecto/anterior/mia.html
# MIA_FRONTEND__ASSETS_DIR=C:/ruta/al/proyecto/anterior/assets

MIA_OBSERVABILITY__LOG_JSON=false
MIA_OBSERVABILITY__LOG_LEVEL=INFO
