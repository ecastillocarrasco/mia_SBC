{
  "name": "mia-desktop-sbc",
  "version": "0.3.2",
  "description": "mIA Desktop - Prototipo independiente para Sunset Beach Club",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "package:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0"
  },
  "build": {
    "appId": "es.sunsetbeachclub.mia.desktop",
    "productName": "mIA Desktop SBC",
    "asar": true,
    "asarUnpack": [
      "src/voice/*.py"
    ],
    "files": [
      "src/**/*",
      "dist/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "icon": "assets/mia.ico",
      "target": "nsis",
      "artifactName": "mIA-Desktop-SBC-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "release"
    }
  }
}
