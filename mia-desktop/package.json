{
  "name": "mia-desktop-sbc",
  "version": "0.3.7",
  "description": "mIA Desktop - Prototipo independiente para Sunset Beach Club",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "package:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@azure/msal-node": "^2.16.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0"
  },
  "build": {
    "appId": "es.sunsetbeachclub.mia.desktop",
    "productName": "mIA Desktop SBC",
    "asar": true,
    "asarUnpack": [
      "src/voice/*.py"
    ],
    "files": [
      "src/**/*",
      "dist/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraFiles": [
      { "from": "PROBAR_PRE_instalado.cmd", "to": "PROBAR_PRE_instalado.cmd" },
      { "from": "INSTALAR_VOZ_LOCAL.cmd", "to": "INSTALAR_VOZ_LOCAL.cmd" },
      { "from": "src/voice/requirements.txt", "to": "src/voice/requirements.txt" },
      { "from": "src/voice/install_models.py", "to": "src/voice/install_models.py" }
    ],
    "win": {
      "icon": "assets/mia.ico",
      "target": "nsis",
      "artifactName": "mIA-Desktop-SBC-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "include": "installer/installer.nsh"
    },
    "directories": {
      "output": "release"
    }
  }
}
