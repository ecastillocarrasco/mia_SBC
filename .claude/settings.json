{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "plan",
    "ask": [
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(npm install *)",
      "PowerShell(pip install *)",
      "PowerShell(py -m pip install *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(npm install *)",
      "Bash(pip install *)"
    ],
    "deny": [
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",

      "Edit(/MIA Backend Legacy)",
      "Edit(/MIA Backend Legacy/**)",

      "Read(**/.env*)",
      "Read(!**/.env.example)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/*.key)",
      "Read(**/secrets/**)",
      "Read(**/credentials/**)"
    ]
  }
}